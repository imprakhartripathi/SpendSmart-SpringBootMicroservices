SERVER_PORT=8082
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true

DB_URL=jdbc:postgresql://localhost:5432/spendsmart_expense
DB_USERNAME=postgres
DB_PASSWORD=postgres

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

BUDGET_SERVICE_URL=http://budget-service
AUTH_SERVICE_URL=http://auth-service
INCOME_SERVICE_URL=http://income-service

BIG_EXPENSE_THRESHOLD_PERCENT=20
BIG_EXPENSE_AVERAGE_MONTHS=6

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=spendsmart.events
RABBITMQ_ROUTING_BIG_EXPENSE=email.big-expense
