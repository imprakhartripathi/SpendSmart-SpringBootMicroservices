# Full variable reference for SpendSmart.
# This is a catalog file, not intended to be loaded as-is for all services.
# Use the service-specific files in this folder for actual IntelliJ run configs.

# Common
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=spendsmart.events
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2s

# Auth
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_auth
JWT_SECRET=change-this-secret-to-64-characters-minimum-for-production
JWT_EXPIRY_HOURS=24
RABBITMQ_ROUTING_WELCOME=email.welcome
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback/google
GOOGLE_SCOPES=openid profile email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/oauth/callback/github
GITHUB_SCOPES=read:user user:email

# Expense
SERVER_PORT=8082
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_expense
BUDGET_SERVICE_URL=http://budget-service
AUTH_SERVICE_URL=http://auth-service
INCOME_SERVICE_URL=http://income-service
RABBITMQ_ROUTING_BIG_EXPENSE=email.big-expense
BIG_EXPENSE_THRESHOLD_PERCENT=20
BIG_EXPENSE_AVERAGE_MONTHS=6

# Income
SERVER_PORT=8083
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_income

# Category
SERVER_PORT=8084
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_category

# Budget
SERVER_PORT=8085
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_budget
NOTIFICATION_SERVICE_URL=http://notification-service
BUDGET_RESET_CRON=0 5 0 * * *

# Analytics
SERVER_PORT=8086
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_analytics
EXPENSE_SERVICE_URL=http://expense-service
INCOME_SERVICE_URL=http://income-service
ANALYTICS_CACHE_TTL=120s

# Recurring
SERVER_PORT=8087
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_recurring
EXPENSE_SERVICE_URL=http://expense-service
INCOME_SERVICE_URL=http://income-service
NOTIFICATION_SERVICE_URL=http://notification-service
AUTH_SERVICE_URL=http://auth-service
RECURRING_REMINDER_CRON=0 30 8 * * *
RABBITMQ_ROUTING_AUTOPAY=email.autopay

# Notification
SERVER_PORT=8088
DB_URL=jdbc:postgresql://localhost:5432/spendsmart_notification
RABBITMQ_EMAIL_QUEUE=spendsmart.notification.email
RABBITMQ_EMAIL_ROUTING_PATTERN=email.*
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@spendsmart.local

# Config Server
SERVER_PORT=8888
SPRING_PROFILES_ACTIVE=native
CONFIG_SERVER_NATIVE_SEARCH_LOCATIONS=classpath:/config
REGISTER_CONFIG_SERVER_WITH_EUREKA=true
FETCH_CONFIG_SERVER_REGISTRY=true

# Discovery Server
SERVER_PORT=8761
DISCOVERY_REGISTER_WITH_EUREKA=false
DISCOVERY_FETCH_REGISTRY=false

# API Gateway
SERVER_PORT=8080
GATEWAY_DISCOVERY_LOCATOR_ENABLED=false
AUTH_SERVICE_URI=lb://auth-service
EXPENSE_SERVICE_URI=lb://expense-service
INCOME_SERVICE_URI=lb://income-service
CATEGORY_SERVICE_URI=lb://category-service
BUDGET_SERVICE_URI=lb://budget-service
ANALYTICS_SERVICE_URI=lb://analytics-service
RECURRING_SERVICE_URI=lb://recurring-service
NOTIFICATION_SERVICE_URI=lb://notification-service

# Frontend
VITE_API_BASE_URL=http://localhost:8080
