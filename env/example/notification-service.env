SERVER_PORT=8088
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true

DB_URL=jdbc:postgresql://localhost:5432/spendsmart_notification
DB_USERNAME=postgres
DB_PASSWORD=postgres

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=spendsmart.events
RABBITMQ_EMAIL_QUEUE=spendsmart.notification.email
RABBITMQ_EMAIL_ROUTING_PATTERN=email.*

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@spendsmart.local
